{
  "rules": {
    "borluulalt": {
      ".read": "auth != null",
      "_meta": {
        ".write": "auth != null"
      },
      "updatedAt": {
        ".write": "auth != null"
      },
      "users": {
        ".write": "auth != null"
      },
      "products": {
        ".write": "auth != null"
      },
      "wines": {
        ".write": "auth != null"
      },
      "submissions": {
        ".write": "auth != null"
      },
      "logs": {
        ".write": "auth != null"
      },
      "rosters": {
        ".write": "auth != null"
      },
      "payments": {
        ".write": "auth != null"
      },
      "inbox": {
        ".write": "auth != null",
        ".indexOn": [
          "submittedAt"
        ]
      },
      "deleted": {
        ".write": "auth != null",
        ".indexOn": [
          "at"
        ]
      },
      "stockLedger": {
        ".write": "auth != null",
        ".indexOn": [
          "at"
        ]
      },
      "reports": {
        ".indexOn": [
          "at",
          "status"
        ],
        "$rid": {
          ".write": "auth != null && newData.exists() && (!data.exists() || newData.child('text').val() === data.child('text').val())",
          ".validate": "newData.hasChildren(['at', 'by', 'role', 'kind', 'text', 'status'])",
          "at": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "role": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "category": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "statusAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "statusBy": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "fixNote": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "kind": {
            ".validate": "newData.isString() && newData.val().matches(/^(user|auto)$/)"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(new|fixing|fixed)$/) && (data.exists() || newData.val() === 'new')"
          },
          "shot": {
            ".validate": "newData.isString() && newData.val().length <= 420000 && newData.val().beginsWith('data:image/')"
          },
          "ctx": {
            "$k": {
              ".validate": "newData.isString() ? newData.val().length <= 8000 : (newData.isNumber() || newData.isBoolean())"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".write": "auth != null"
      }
    },
    "borluulalt_secret": {
      ".read": false,
      ".write": false
    }
  }
}
